# Cloudflare Tunnel token (required for tunnel service)
# Get from: https://one.dash.cloudflare.com/
CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# Optional Umami analytics
# Leave empty to disable analytics completely.
VITE_UMAMI_WEBSITE_ID=
# Optional custom host, defaults to https://analytics.umami.is
VITE_UMAMI_HOST=
# Optional domain filter, defaults to current hostname
VITE_UMAMI_DOMAINS=
