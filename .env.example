# ============================================
# Pet-Bewerbung Environment Configuration
# ============================================
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!
#
# How to set up:
# 1. cp .env.example .env
# 2. Fill in all REQUIRED fields below
# 3. Verify .env is in .gitignore
# ============================================

# ============================================
# CRITICAL: JWT Secret (REQUIRED in ALL environments)
# ============================================
# Used for signing premium session tokens
# MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_min_32_chars_CHANGE_THIS

# Premium session duration (hours)
PREMIUM_DURATION_HOURS=2

# ============================================
# Stripe Configuration (REQUIRED for payments)
# ============================================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe webhook secret (REQUIRED for production)
# Get from: https://dashboard.stripe.com/webhooks
# Test webhooks locally: stripe listen --forward-to localhost:4242/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# Redis Configuration (REQUIRED for production)
# ============================================
# Rate limiting uses Redis
# Local development: docker run -d -p 6379:6379 redis:7-alpine
# Production: Use managed Redis (AWS ElastiCache, Redis Cloud, etc.)
REDIS_URL=redis://localhost:6379

# ============================================
# AI Configuration (Optional)
# ============================================
# Google Gemini API key for AI text generation
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI rate limiting (requests per 24 hours)
AI_RATE_LIMIT=3
AI_RATE_LIMIT_FREE=1

# ============================================
# Server Configuration
# ============================================
# Server port
PORT=4242

# Node environment (development|production)
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://pet-bewerbung.ch

# Allowed CORS origins (comma-separated)
# Leave empty to use defaults
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Cloudflare Tunnel (Optional - for production)
# ============================================
# Cloudflare Tunnel token for secure remote access
# Get from: https://dash.cloudflare.com
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ============================================
# SECURITY CHECKLIST
# ============================================
# [ ] JWT_SECRET is at least 32 random characters
# [ ] Stripe keys are from the correct environment (test/live)
# [ ] Redis URL is correct and Redis is running
# [ ] STRIPE_WEBHOOK_SECRET matches your webhook endpoint
# [ ] .env file is in .gitignore
# [ ] Never share or commit .env file
# [ ] Rotate all secrets if .env is ever exposed
# ============================================
