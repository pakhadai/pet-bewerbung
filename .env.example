# ============================================
# Pet-Bewerbung Environment Configuration
# ============================================
# Copy to .env and fill in your values
# NEVER commit .env to git!
# ============================================

# ============================================
# Redis (REQUIRED for production)
# ============================================
# Rate limiting uses Redis
# Local: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# ============================================
# AI (Optional - for text generation)
# ============================================
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI requests per 24h per IP (default: 5)
AI_RATE_LIMIT=5

# ============================================
# Server
# ============================================
PORT=4242
NODE_ENV=development
FRONTEND_URL=https://pet-bewerbung.ch

# CORS origins (comma-separated, empty = defaults)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
